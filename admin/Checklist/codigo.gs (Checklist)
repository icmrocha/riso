function doGet(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const abaMaster = ss.getSheetByName("MASTER");
  const abaLog = ss.getSheetByName("LOG");

  const dadosMaster = abaMaster.getDataRange().getValues();
  dadosMaster.shift();

  const dadosLog = abaLog ? abaLog.getDataRange().getValues() : [];
  if (dadosLog.length > 0) dadosLog.shift();

  const cicloAtual = PropertiesService.getScriptProperties().getProperty("cicloAtual") || "";

  // Histórico das recorrentes: todas as linhas LOG com id RECORRENTE.
  // Não entra no statusMap do sábado.
  const historicoMap = {};
  dadosLog.forEach(function (linha) {
    if (String(linha[0]) !== "RECORRENTE") return;
    const tarefa = linha[2];
    const status = linha[4];
    const horario = linha[5] ? String(linha[5]) : "";
    if (!tarefa || !horario) return;
    if (!(status === "CONCLUIDO" || status === "TRUE" || status === true)) return;
    const chave = String(linha[1] || "") + "_" + String(tarefa);
    if (!historicoMap[chave]) historicoMap[chave] = [];
    historicoMap[chave].push(horario);
    if (!historicoMap[String(tarefa)]) historicoMap[String(tarefa)] = [];
    historicoMap[String(tarefa)].push(horario);
  });

  const statusMap = {};
  dadosLog.forEach(function (linha) {
    const idServico = linha[0];
    const categoria = linha[1];
    const tarefa = linha[2];
    const status = linha[4];
    const horario = linha[5];
    const comentario = linha[6] ? String(linha[6]) : "";
    if (!categoria || !tarefa) return;
    if (cicloAtual && String(idServico) !== String(cicloAtual)) return;

    const feito = status === "CONCLUIDO" || status === "TRUE" || status === true;
    const info = { done: feito, completedAt: horario || "", comentario: comentario };
    statusMap[categoria + "_" + tarefa] = info;
    statusMap[tarefa] = info;
  });

  const masterPorChave = {};
  const masterLista = [];
  dadosMaster.forEach(function (linha) {
    const categoria = linha[0];
    const tarefa = linha[1];
    const tag = linha[2] || "Cozinha";
    const detalhe = linha[3] ? String(linha[3]) : "";
    if (!categoria || !tarefa) return;
    const chave = categoria + "_" + tarefa;
    masterPorChave[chave] = {
      categoria: categoria,
      tarefa: tarefa,
      tag: tag,
      detalhe: detalhe,
      recorrencia: linha[4] ? String(linha[4]).trim() : "",
      recorrenciaValor: linha[5] ? String(linha[5]).trim() : "",
      proximaEm: formatarDataPlanilha(linha[6])
    };
    masterLista.push(chave);
  });

  const ordemDoDia = [];
  const abaOrdem = ss.getSheetByName("ORDEM_CICLO");
  if (abaOrdem && cicloAtual) {
    const dadosOrdem = abaOrdem.getDataRange().getValues();
    dadosOrdem.shift();
    dadosOrdem.forEach(function (linha) {
      if (String(linha[0]) !== String(cicloAtual)) return;
      if (!linha[1] || !linha[2]) return;
      ordemDoDia.push({
        categoria: linha[1],
        tarefa: linha[2],
        tag: linha[3] || "Cozinha"
      });
    });
  }

  const categoriasMap = {};
  const usados = {};

  function adicionar(categoria, tarefa, tag, detalhe, recInfo) {
    if (!categoriasMap[categoria]) {
      categoriasMap[categoria] = { category: categoria, tasks: [] };
    }
    const logExistente = statusMap[categoria + "_" + tarefa] || statusMap[tarefa] || null;
    const rec = recInfo || {};
    const isRecorrente = ehRecorrente(rec.recorrencia);
    // Recorrente não usa "done" de G. Check persistente saiu do fluxo.
    const vencida = isRecorrente ? tarefaRecorrenteVencida(rec.proximaEm) : false;
    const done = isRecorrente ? false : (logExistente ? logExistente.done : false);

    const histBruto = historicoMap[categoria + "_" + tarefa] || historicoMap[tarefa] || [];
    const historico = histBruto.slice().reverse().slice(0, 3);
    const podeDesfazer = isRecorrente && historico.length > 0 && horarioEhHoje(historico[0]);

    categoriasMap[categoria].tasks.push({
      text: tarefa,
      tag: tag || "Cozinha",
      detalhe: detalhe || "",
      done: done,
      completedAt: isRecorrente ? "" : (logExistente ? logExistente.completedAt : ""),
      comentario: logExistente && logExistente.comentario ? logExistente.comentario : "",
      isRecorrente: isRecorrente,
      vencida: vencida,
      recorrencia: rec.recorrencia || "",
      recorrenciaValor: rec.recorrenciaValor || "",
      proximaEm: rec.proximaEm || "",
      historico: isRecorrente ? historico : [],
      podeDesfazer: podeDesfazer
    });
  }

  if (ordemDoDia.length > 0) {
    ordemDoDia.forEach(function (item) {
      const m = masterPorChave[item.categoria + "_" + item.tarefa];
      adicionar(
        item.categoria,
        item.tarefa,
        item.tag,
        m ? m.detalhe : "",
        m || {}
      );
      usados[item.categoria + "_" + item.tarefa] = true;
      usados[item.tarefa] = true;
    });
    masterLista.forEach(function (chave) {
      const m = masterPorChave[chave];
      if (usados[chave] || usados[m.tarefa]) return;
      adicionar(m.categoria, m.tarefa, m.tag, m.detalhe, m);
    });
  } else {
    masterLista.forEach(function (chave) {
      const m = masterPorChave[chave];
      adicionar(m.categoria, m.tarefa, m.tag, m.detalhe, m);
    });
  }

  const saida = Object.values(categoriasMap);
  saida.forEach(function (cat) {
    if (String(cat.category) !== "TAREFA RECORRENTE") return;
    cat.tasks.sort(function (a, b) {
      return dataSortKey(a.proximaEm) - dataSortKey(b.proximaEm);
    });
  });

  return ContentService.createTextOutput(JSON.stringify(saida))
    .setMimeType(ContentService.MimeType.JSON);
}

function dataSortKey(texto) {
  const dt = parseDataBr(texto);
  if (!dt) return 0;
  return dt.getTime();
}

function doPost(e) {
  try {
    const dadosRecebidos = JSON.parse(e.postData.contents);
    const ss = SpreadsheetApp.getActiveSpreadsheet();

    if (dadosRecebidos.acao === "CRIAR_TAREFA") {
      const abaMaster = ss.getSheetByName("MASTER");
      const rec = String(dadosRecebidos.recorrencia || "").trim();
      const valor = String(dadosRecebidos.recorrenciaValor || "").trim();
      const isRec = ehRecorrente(rec);
      abaMaster.appendRow([
        dadosRecebidos.categoria,
        dadosRecebidos.tarefa,
        dadosRecebidos.tag || "Cozinha",
        dadosRecebidos.detalhe || "",
        isRec ? rec : "TODOSERVICO",
        valor,
        isRec ? dataHojeBr() : ""
      ]);
      return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
        .setMimeType(ContentService.MimeType.JSON);
    }

    if (dadosRecebidos.acao === "RESET") {
      const novoId = dadosRecebidos.idServico || ("SERV_" + Date.now());
      PropertiesService.getScriptProperties().setProperty("cicloAtual", novoId);
      return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // Recorrente concluída: HISTÓRICO vai para o LOG (linha nova).
    // G da MASTER só guarda a PRÓXIMA data — não é arquivo morto.
    if (dadosRecebidos.acao === "CONCLUIR_RECORRENTE") {
      const aba = ss.getSheetByName("MASTER");
      const alvo = String(dadosRecebidos.tarefa || "").trim();
      const catAlvo = String(dadosRecebidos.categoria || "").trim();
      const feito = dadosRecebidos.feito !== false;
      const dados = aba.getDataRange().getValues();
      for (let i = 1; i < dados.length; i++) {
        const cat = String(dados[i][0] || "").trim();
        const nome = String(dados[i][1] || "").trim();
        if (nome !== alvo) continue;
        if (catAlvo && cat !== catAlvo) continue;
        const recTipo = String(dados[i][4] || "").trim();
        const valor = String(dados[i][5] || "").trim();
        const tagLinha = String(dados[i][2] || dadosRecebidos.tag || "Cozinha");
        // Só atualiza G (próxima). Não apaga conclusão antiga.
        if (!feito) break;
        aba.getRange(i + 1, 7).setValue(somarIntervalo(dataHoje(), recTipo, valor));
        const abaLog = ss.getSheetByName("LOG");
        abaLog.appendRow([
          "RECORRENTE",
          cat,
          nome,
          tagLinha,
          "CONCLUIDO",
          dadosRecebidos.horarioConclusao || dataHojeBr(),
          ""
        ]);
        break;
      }
      return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // Apaga só o carimbo de HOJE no LOG e recalcula G pela penúltima Feita.
    if (dadosRecebidos.acao === "DESFAZER_RECORRENTE") {
      const abaMaster = ss.getSheetByName("MASTER");
      const abaLog = ss.getSheetByName("LOG");
      const alvo = String(dadosRecebidos.tarefa || "").trim();
      const catAlvo = String(dadosRecebidos.categoria || "").trim();
      const dadosLog = abaLog.getDataRange().getValues();
      let apagou = false;
      for (let i = dadosLog.length; i >= 2; i--) {
        const lin = dadosLog[i - 1];
        if (String(lin[0]) !== "RECORRENTE") continue;
        if (String(lin[2] || "").trim() !== alvo) continue;
        if (catAlvo && String(lin[1] || "").trim() !== catAlvo) continue;
        if (!horarioEhHoje(lin[5])) break;
        abaLog.deleteRow(i);
        apagou = true;
        break;
      }
      if (apagou) {
        const dadosM = abaMaster.getDataRange().getValues();
        for (let i = 1; i < dadosM.length; i++) {
          const cat = String(dadosM[i][0] || "").trim();
          const nome = String(dadosM[i][1] || "").trim();
          if (nome !== alvo) continue;
          if (catAlvo && cat !== catAlvo) continue;
          const recTipo = String(dadosM[i][4] || "").trim();
          const valor = String(dadosM[i][5] || "").trim();
          const resto = abaLog.getDataRange().getValues();
          let ultima = "";
          for (let k = resto.length - 1; k >= 1; k--) {
            if (String(resto[k][0]) !== "RECORRENTE") continue;
            if (String(resto[k][2] || "").trim() !== alvo) continue;
            ultima = resto[k][5];
            break;
          }
          const base = parseDataDeHorario(ultima);
          const novaG = base ? somarIntervalo(base, recTipo, valor) : "";
          abaMaster.getRange(i + 1, 7).setValue(novaG);
          break;
        }
      }
      return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
        .setMimeType(ContentService.MimeType.JSON);
    }

    if (dadosRecebidos.acao === "SALVAR_ORDEM") {
      const ciclo = PropertiesService.getScriptProperties().getProperty("cicloAtual")
        || dadosRecebidos.idServico
        || "";
      const aba = ss.getSheetByName("ORDEM_CICLO") || ss.insertSheet("ORDEM_CICLO");
      if (aba.getLastRow() === 0) {
        aba.appendRow(["idCiclo", "categoria", "tarefa", "tag", "posicao"]);
      }

      if (dadosRecebidos.acao === "SALVAR_COMENTARIO") {
        const abaLog = ss.getSheetByName("LOG");
        const cicloCasa = PropertiesService.getScriptProperties().getProperty("cicloAtual")
          || dadosRecebidos.idServico
          || "SERVICO_PADRAO";
        abaLog.appendRow([
          cicloCasa,
          dadosRecebidos.categoria,
          dadosRecebidos.tarefa,
          dadosRecebidos.tag || "Cozinha",
          dadosRecebidos.done ? "CONCLUIDO" : "PENDENTE",
          dadosRecebidos.horarioConclusao || "",
          dadosRecebidos.comentario || ""
        ]);
        return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
          .setMimeType(ContentService.MimeType.JSON);
      }

      const itens = dadosRecebidos.itens || [];
      const dados = aba.getDataRange().getValues();
      for (let i = dados.length; i >= 2; i--) {
        if (String(dados[i - 1][0]) === String(ciclo)) {
          aba.deleteRow(i);
        }
      }
      itens.forEach(function (item, idx) {
        aba.appendRow([ciclo, item.categoria, item.tarefa, item.tag || "Cozinha", idx + 1]);
      });

      return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
        .setMimeType(ContentService.MimeType.JSON);
    }

    const abaLog = ss.getSheetByName("LOG");
    const { idServico, categoria, tarefa, tag, status, horarioConclusao } = dadosRecebidos;

    const cicloCasa = PropertiesService.getScriptProperties().getProperty("cicloAtual")
      || idServico
      || "SERVICO_PADRAO";

    abaLog.appendRow([
      cicloCasa,
      categoria,
      tarefa,
      tag,
      (status === true || status === "TRUE" || status === "CONCLUIDO") ? "CONCLUIDO" : "PENDENTE",
      horarioConclusao || "",
      dadosRecebidos.comentario || ""
    ]);

    return ContentService.createTextOutput(JSON.stringify({ status: "sucesso" }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({ status: "erro", mensagem: error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function ehRecorrente(tipo) {
  const t = String(tipo || "").trim().toUpperCase();
  if (!t || t === "TODOSERVICO" || t === "TODO SERVIÇO") return false;
  return true;
}

function dataHoje() {
  const s = Utilities.formatDate(new Date(), "America/Sao_Paulo", "yyyy-MM-dd");
  const p = s.split("-");
  return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
}

function dataHojeBr() {
  return Utilities.formatDate(new Date(), "America/Sao_Paulo", "dd/MM/yyyy");
}

function formatarDataPlanilha(valor) {
  if (!valor) return "";
  if (Object.prototype.toString.call(valor) === "[object Date]" && !isNaN(valor.getTime())) {
    return Utilities.formatDate(valor, "America/Sao_Paulo", "dd/MM/yyyy");
  }
  return String(valor).trim();
}

function parseDataBr(texto) {
  return parseDataDeHorario(texto);
}

function parseDataDeHorario(texto) {
  const t = String(texto || "");
  const m = t.match(/(\d{1,2})\/(\d{1,2})\/(\d{2,4})/);
  if (!m) return null;
  let ano = Number(m[3]);
  if (ano < 100) ano += 2000;
  const dt = new Date(ano, Number(m[2]) - 1, Number(m[1]));
  dt.setHours(0, 0, 0, 0);
  return isNaN(dt.getTime()) ? null : dt;
}

function horarioEhHoje(texto) {
  const dt = parseDataDeHorario(texto);
  if (!dt) return false;
  return dt.getTime() === dataHoje().getTime();
}

function tarefaRecorrenteVencida(proximaEm) {
  const dt = parseDataBr(proximaEm);
  if (!dt) return true;
  const hoje = dataHoje();
  hoje.setHours(0, 0, 0, 0);
  return dt.getTime() <= hoje.getTime();
}

function padraoDoTipo(tipo) {
  const t = String(tipo || "").trim().toUpperCase();
  if (t === "SEMI-MENSAL" || t === "SEMIMENSAL") return { n: 15, unidade: "dias" };
  if (t === "MENSAL") return { n: 1, unidade: "meses" };
  if (t === "BIMESTRAL") return { n: 2, unidade: "meses" };
  if (t === "TRIMESTRAL") return { n: 3, unidade: "meses" };
  if (t === "SEMESTRAL") return { n: 6, unidade: "meses" };
  if (t === "ANUAL") return { n: 12, unidade: "meses" };
  return { n: 1, unidade: "meses" };
}

function lerIntervalo(tipo, valorTexto) {
  const fallback = padraoDoTipo(tipo);
  const raw = String(valorTexto || "").trim().toLowerCase();
  if (!raw) return fallback;
  const m = raw.match(/(\d+)/);
  if (!m) return fallback;
  const n = Number(m[1]);
  if (!n) return fallback;
  if (/dia/.test(raw)) return { n: n, unidade: "dias" };
  if (/ano/.test(raw)) return { n: n * 12, unidade: "meses" };
  if (/mes/.test(raw)) return { n: n, unidade: "meses" };
  return fallback;
}

function somarIntervalo(base, tipo, valorTexto) {
  const iv = lerIntervalo(tipo, valorTexto);
  const d = new Date(base.getTime());
  if (iv.unidade === "dias") {
    d.setDate(d.getDate() + iv.n);
  } else {
    d.setMonth(d.getMonth() + iv.n);
  }
  return Utilities.formatDate(d, "America/Sao_Paulo", "dd/MM/yyyy");
}