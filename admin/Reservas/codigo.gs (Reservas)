/**
 * Riso — backend de reservas (Apps Script).
 *
 * Planilha = livro de reservas (fonte da verdade).
 * Este Script: cria/edita/cancela, agenda do dia, espelho no Google Agenda.
 *
 * Ações POST (JSON no body):
 *   salvarDatasLiberadas | salvarAjudantes | editarReserva
 *   atualizarStatusReserva | (sem action = nova reserva)
 *
 * GET: getDatasLiberadas | getTodasReservas | getReservasData | disponibilidade
 */
const SPREADSHEET_ID = SpreadsheetApp.getActiveSpreadsheet().getId();
const SHEET_RESERVAS = "Reservas_Ativas";
const SHEET_DATAS_LIBERADAS = "Datas_Liberadas";
const MAX_CAPACIDADE_POR_HORA = 8;

// Destino antigo do n8n. Vazio = não dispara webhook.
const N8N_WEBHOOK_URL = "";

function obterOuCriarAba(nomeAba) {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  let sheet = ss.getSheetByName(nomeAba);
  if (!sheet) {
    sheet = ss.insertSheet(nomeAba);
    if (nomeAba === SHEET_DATAS_LIBERADAS) {
      sheet.appendRow(["Data_Liberada", "Horarios_Ativos"]);
    }
  }
  return sheet;
}

function doPost(e) {
  // Uma reserva por vez. Evita dois cliques no mesmo segundo
  // criarem dois eventos de calendário para o mesmo sábado.
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
  } catch (err) {
    return respostaJSON({
      status: "error",
      message: "O sistema está processando muitas solicitações simultâneas. Tente novamente."
    });
  }

  try {
    const payload = JSON.parse(e.postData.contents);
    const action = payload.action;

    // ---- Agenda do painel ADM (quais dias/horários estão abertos) ----
    if (action === "salvarDatasLiberadas") {
      const sheetDatas = obterOuCriarAba(SHEET_DATAS_LIBERADAS);
      sheetDatas.clearContents();
      sheetDatas.appendRow(["Data_Liberada", "Horarios_Ativos"]);

      const agendaMap = payload.agendaMap || {};
      Object.keys(agendaMap).forEach(function (dataStr) {
        const horariosArr = agendaMap[dataStr];
        if (Array.isArray(horariosArr) && horariosArr.length > 0) {
          // O apóstrofo força texto. Senão o Sheets vira Date e quebra o filtro.
          sheetDatas.appendRow(["'" + dataStr, JSON.stringify(horariosArr)]);
        }
      });
      return respostaJSON({ status: "success", message: "Agenda e horários salvos com sucesso!" });
    }

    // ---- Ajudantes do dia (propriedade do Script, não é coluna da planilha) ----
    if (action === "salvarAjudantes") {
      const props = PropertiesService.getScriptProperties();
      const mapa = JSON.parse(props.getProperty("ajudantesPorData") || "{}");
      mapa[payload.data] = payload.nomes || "";
      props.setProperty("ajudantesPorData", JSON.stringify(mapa));
      return respostaJSON({ status: "success" });
    }

    // ---- Editar reserva já existente (ADM; sem teto de 8) ----
    if (action === "editarReserva") {
      const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_RESERVAS);
      const dados = sheet.getDataRange().getValues();
      const codigoAlvo = String(payload.codigoReserva || "").trim();
      let linha = -1;
      for (let i = 1; i < dados.length; i++) {
        const c7 = String(dados[i][6]).trim();
        const c9 = String(dados[i][8] || dados[i][6]).trim();
        if (c7 === codigoAlvo || c9 === codigoAlvo) {
          linha = i + 1;
          break;
        }
      }
      if (linha === -1) {
        return respostaJSON({ status: "error", message: "Reserva não encontrada." });
      }

      // Data antiga ANTES de sobrescrever: se o ADM mudou o dia,
      // o sábado velho também precisa atualizar (ou apagar) o evento.
      const dataAntiga = normalizarDataParaPtBr(sheet.getRange(linha, 1).getValue());
      const dataAlvo = normalizarDataParaPtBr(payload.dataReserva);
      const horario = normalizarHorario(payload.horario);
      const pessoas = Number(payload.pessoas) || 0;
      if (!dataAlvo || !horario || pessoas <= 0) {
        return respostaJSON({ status: "error", message: "Dados inválidos." });
      }

      sheet.getRange(linha, 1).setValue("'" + dataAlvo);
      sheet.getRange(linha, 2).setValue("'" + horario);
      sheet.getRange(linha, 3).setValue(payload.nome || "");
      sheet.getRange(linha, 4).setValue("'" + String(payload.telefone || ""));
      sheet.getRange(linha, 5).setValue(pessoas);
      sheet.getRange(linha, 6).setValue(payload.observacoes || "Nenhuma");

      sincronizarCalendarioDoDia(dataAlvo);
      if (dataAntiga && dataAntiga !== dataAlvo) {
        sincronizarCalendarioDoDia(dataAntiga);
      }
      return respostaJSON({ status: "success" });
    }

    // ---- Status: CANCELADA / REALIZADA / REABRIR ----
    if (action === "atualizarStatusReserva") {
      const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_RESERVAS);
      const dados = sheet.getDataRange().getValues();
      const codigoAlvo = String(payload.codigoReserva).trim();
      const novoStatus = String(payload.novoStatus).trim();

      let linhaEncontrada = -1;
      for (let i = 1; i < dados.length; i++) {
        const codigoLinha = String(dados[i][6]).trim();
        const codigoOriginal = String(dados[i][8] || dados[i][6]).trim();
        if (codigoLinha === codigoAlvo || codigoOriginal === codigoAlvo) {
          linhaEncontrada = i + 1;
          break;
        }
      }
      if (linhaEncontrada === -1) {
        return respostaJSON({ status: "error", message: "Reserva não encontrada." });
      }

      const codigoAtualNaPlanilha = String(sheet.getRange(linhaEncontrada, 7).getValue()).trim();
      let codigoOriginalGeral = String(sheet.getRange(linhaEncontrada, 9).getValue()).trim();
      if (!codigoOriginalGeral) {
        codigoOriginalGeral = codigoAtualNaPlanilha.startsWith("#RISO-")
          ? codigoAtualNaPlanilha
          : ("#RISO-" + Math.random().toString(36).substring(2, 6).toUpperCase());
        sheet.getRange(linhaEncontrada, 9).setValue(codigoOriginalGeral);
      }

      if (novoStatus === "CANCELADA") {
        sheet.getRange(linhaEncontrada, 7).setValue("CANCELADA");
      } else if (novoStatus === "REALIZADA") {
        sheet.getRange(linhaEncontrada, 7).setValue("REALIZADA");
      } else if (novoStatus === "REABRIR") {
        sheet.getRange(linhaEncontrada, 7).setValue(codigoOriginalGeral);
      }

      const dataDoStatus = normalizarDataParaPtBr(sheet.getRange(linhaEncontrada, 1).getValue());
      sincronizarCalendarioDoDia(dataDoStatus);

      return respostaJSON({
        status: "success",
        message: "Status atualizado com sucesso!",
        codigoOriginal: codigoOriginalGeral
      });
    }

    // ---- Nova reserva (site do cliente ou modal ADM) ----
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_RESERVAS);
    const dataAlvo = normalizarDataParaPtBr(payload.dataReserva);
    const horarioSolicitado = normalizarHorario(payload.horario);
    const pessoasSolicitadas = Number(payload.pessoas) || 0;
    const forcarOverride = payload.override === true;

    if (!dataAlvo || !horarioSolicitado || pessoasSolicitadas <= 0) {
      return respostaJSON({ status: "error", message: "Dados de reserva inválidos ou incompletos." });
    }

    const agendaMap = obterMapaAgendaLiberada();
    const horariosDoDia = agendaMap[dataAlvo] || [];
    if (!horariosDoDia.includes(horarioSolicitado)) {
      return respostaJSON({
        status: "error",
        message: "O horário das " + horarioSolicitado + " não está aberto para reservas nesta data."
      });
    }

    const dados = sheet.getDataRange().getValues();
    let totalPessoasExistentes = 0;
    for (let i = 1; i < dados.length; i++) {
      const dataLinha = normalizarDataParaPtBr(dados[i][0]);
      const horarioLinha = normalizarHorario(dados[i][1]);
      const qtdLinha = Number(dados[i][4]) || 0;
      const statusLinha = String(dados[i][6]).trim();
      if (dataLinha === dataAlvo && horarioLinha === horarioSolicitado && statusLinha !== "CANCELADA") {
        totalPessoasExistentes += qtdLinha;
      }
    }

    if (!forcarOverride && (totalPessoasExistentes + pessoasSolicitadas > MAX_CAPACIDADE_POR_HORA)) {
      const vagasRestantes = MAX_CAPACIDADE_POR_HORA - totalPessoasExistentes;
      const msgErro = vagasRestantes > 0
        ? "Infelizmente, restam apenas " + vagasRestantes + " vaga(s) para o horário das " + horarioSolicitado + "."
        : "O horário das " + horarioSolicitado + " já esgotou todas as vagas disponíveis.";
      return respostaJSON({ status: "error", message: msgErro });
    }

    const codigoReserva = "#RISO-" + Math.random().toString(36).substring(2, 6).toUpperCase();
    const dataCriacao = Utilities.formatDate(new Date(), "America/Sao_Paulo", "dd/MM/yyyy HH:mm:ss");
    let observacoesFinais = payload.observacoes || "Nenhuma";
    if (forcarOverride) observacoesFinais += " [OVERRIDE ADM]";

    sheet.appendRow([
      "'" + dataAlvo,
      "'" + horarioSolicitado,
      payload.nome,
      "'" + String(payload.telefone),
      pessoasSolicitadas,
      observacoesFinais,
      codigoReserva,
      dataCriacao,
      codigoReserva
    ]);

    const reservaProcessada = {
      codigoReserva: codigoReserva,
      nome: payload.nome,
      telefone: payload.telefone,
      dataReserva: dataAlvo,
      horario: horarioSolicitado,
      pessoas: pessoasSolicitadas,
      observacoes: observacoesFinais,
      dataCriacao: dataCriacao
    };

    dispararWebhookN8N(reservaProcessada);
    sincronizarCalendarioDoDia(dataAlvo);

    return respostaJSON({ status: "success", codigoReserva: codigoReserva });

  } catch (error) {
    return respostaJSON({ status: "error", message: error.toString() });
  } finally {
    lock.releaseLock();
  }
}

function doGet(e) {
  try {
    const action = e.parameter.action;

    if (action === "getDatasLiberadas") {
      const agendaMap = obterMapaAgendaLiberada();
      return respostaJSON({
        status: "success",
        datasLiberadas: Object.keys(agendaMap),
        agendaMap: agendaMap
      });
    }

    if (action === "getTodasReservas") {
      const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_RESERVAS);
      const dados = sheet.getDataRange().getValues();
      const todasReservas = [];
      for (let i = 1; i < dados.length; i++) {
        if (dados[i][0]) {
          todasReservas.push({
            data: normalizarDataParaPtBr(dados[i][0]),
            horario: normalizarHorario(dados[i][1]),
            nome: dados[i][2],
            telefone: String(dados[i][3]),
            pessoas: dados[i][4],
            observacoes: dados[i][5],
            codigo: String(dados[i][6]).trim(),
            codigoOriginal: String(dados[i][8] || dados[i][6]).trim()
          });
        }
      }
      const ajudantes = JSON.parse(
        PropertiesService.getScriptProperties().getProperty("ajudantesPorData") || "{}"
      );
      return respostaJSON({
        status: "success",
        reservas: todasReservas,
        ajudantes: ajudantes
      });
    }

    const dataConsultaRaw = e.parameter.data;
    if (!dataConsultaRaw) {
      return respostaJSON({ status: "error", message: "Data não fornecida." });
    }

    const dataAlvo = normalizarDataParaPtBr(dataConsultaRaw);
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_RESERVAS);
    const dados = sheet.getDataRange().getValues();

    if (action === "getReservasData") {
      const reservasDoDia = [];
      for (let i = 1; i < dados.length; i++) {
        if (normalizarDataParaPtBr(dados[i][0]) === dataAlvo) {
          reservasDoDia.push({
            data: dataAlvo,
            horario: normalizarHorario(dados[i][1]),
            nome: dados[i][2],
            telefone: String(dados[i][3]),
            pessoas: dados[i][4],
            observacoes: dados[i][5],
            codigo: String(dados[i][6]).trim(),
            codigoOriginal: String(dados[i][8] || dados[i][6]).trim()
          });
        }
      }
      return respostaJSON({ status: "success", reservas: reservasDoDia });
    }

    // Disponibilidade da tela do cliente
    const agendaMap = obterMapaAgendaLiberada();
    const horariosAtivosDoDia = agendaMap[dataAlvo] || [];
    const dataEstaLiberada = horariosAtivosDoDia.length > 0;
    const disponibilidade = {};
    horariosAtivosDoDia.forEach(function (h) {
      disponibilidade[h] = { ocupadas: 0, disponiveis: MAX_CAPACIDADE_POR_HORA, esmaecer: false };
    });

    if (dataEstaLiberada) {
      for (let i = 1; i < dados.length; i++) {
        const dataLinha = normalizarDataParaPtBr(dados[i][0]);
        const horarioReserva = normalizarHorario(dados[i][1]);
        const qtdPessoas = Number(dados[i][4]) || 0;
        const statusLinha = String(dados[i][6]).trim();
        if (dataLinha === dataAlvo && disponibilidade[horarioReserva] && statusLinha !== "CANCELADA") {
          disponibilidade[horarioReserva].ocupadas += qtdPessoas;
        }
      }
      Object.keys(disponibilidade).forEach(function (horario) {
        const vagasRestantes = MAX_CAPACIDADE_POR_HORA - disponibilidade[horario].ocupadas;
        disponibilidade[horario].disponiveis = vagasRestantes > 0 ? vagasRestantes : 0;
        disponibilidade[horario].esmaecer = vagasRestantes <= 0;
      });
    }

    return respostaJSON({
      status: "success",
      data: dataConsultaRaw,
      dataLiberada: dataEstaLiberada,
      disponibilidade: disponibilidade
    });
  } catch (error) {
    return respostaJSON({ status: "error", message: error.toString() });
  }
}

function obterMapaAgendaLiberada() {
  const sheetDatas = obterOuCriarAba(SHEET_DATAS_LIBERADAS);
  const dados = sheetDatas.getDataRange().getValues();
  const map = {};
  for (let i = 1; i < dados.length; i++) {
    const dataStr = normalizarDataParaPtBr(dados[i][0]);
    const horariosCol = dados[i][1];
    if (!dataStr) continue;
    if (horariosCol) {
      try {
        const parsed = JSON.parse(horariosCol);
        map[dataStr] = Array.isArray(parsed) ? parsed : ["12:00", "13:00", "14:00", "15:00", "16:00"];
      } catch (err) {
        map[dataStr] = ["12:00", "13:00", "14:00", "15:00", "16:00"];
      }
    } else {
      map[dataStr] = ["12:00", "13:00", "14:00", "15:00", "16:00"];
    }
  }
  return map;
}

function normalizarDataParaPtBr(val) {
  if (!val) return "";
  if (val instanceof Date) {
    return Utilities.formatDate(val, "America/Sao_Paulo", "dd/MM/yyyy");
  }
  const str = String(val).trim();
  if (str.indexOf("-") !== -1) {
    const partes = str.split("T")[0].split("-");
    if (partes.length === 3 && partes[0].length === 4) {
      return partes[2].padStart(2, "0") + "/" + partes[1].padStart(2, "0") + "/" + partes[0];
    }
  }
  if (str.indexOf("/") !== -1) {
    const p = str.split("/");
    if (p.length === 3) {
      return p[0].padStart(2, "0") + "/" + p[1].padStart(2, "0") + "/" + p[2];
    }
  }
  return str;
}

function normalizarHorario(val) {
  if (!val) return "";
  if (val instanceof Date) {
    return Utilities.formatDate(val, "America/Sao_Paulo", "HH:mm");
  }
  const str = String(val).trim();
  const partes = str.split(":");
  if (partes.length >= 2) {
    return partes[0].padStart(2, "0") + ":" + partes[1].padStart(2, "0");
  }
  return str;
}

function dispararWebhookN8N(dadosReserva) {
  // Aviso no WhatsApp da casa (CallMeBot).
  // Telefone e apikey ficam nas Propriedades do Script:
  // CALLMEBOT_1_PHONE / CALLMEBOT_1_KEY
  // CALLMEBOT_2_PHONE / CALLMEBOT_2_KEY (opcional)
  const props = PropertiesService.getScriptProperties();
  const texto = [
    "Nova reserva Riso",
    dadosReserva.codigoReserva || "",
    (dadosReserva.nome || "") + " · " + (dadosReserva.pessoas || "") + "p",
    (dadosReserva.dataReserva || "") + " " + (dadosReserva.horario || ""),
    dadosReserva.observacoes ? ("Obs: " + dadosReserva.observacoes) : ""
  ].filter(String).join("\n");

  enviarCallMeBot(props.getProperty("CALLMEBOT_1_PHONE"), props.getProperty("CALLMEBOT_1_KEY"), texto);
  enviarCallMeBot(props.getProperty("CALLMEBOT_2_PHONE"), props.getProperty("CALLMEBOT_2_KEY"), texto);
}

function enviarCallMeBot(phone, apikey, texto) {
  if (!phone || !apikey) return;
  const url = "https://api.callmebot.com/whatsapp.php"
    + "?phone=" + encodeURIComponent(String(phone).replace(/\D/g, ""))
    + "&apikey=" + encodeURIComponent(apikey)
    + "&text=" + encodeURIComponent(texto);
  try {
    UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
  } catch (err) {}
}

function respostaJSON(objeto) {
  return ContentService.createTextOutput(JSON.stringify(objeto))
    .setMimeType(ContentService.MimeType.JSON);
}

/**
 * Um evento por DIA de serviço no calendário padrão da conta
 * que publica este Web App. Compartilhe essa agenda com o outro sócio.
 *
 * Quem editar o evento na mão perde a alteração no próximo sync.
 * Id guardado em Script Properties (calEventosPorData):
 * salvar a agenda no painel apaga Datas_Liberadas e não serve para o id.
 *
 * Se o Calendar falhar, a reserva na planilha já foi gravada. Engolimos o erro.
 */
function sincronizarCalendarioDoDia(dataPtBr) {
  try {
    if (!dataPtBr) return;

    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_RESERVAS);
    const dados = sheet.getDataRange().getValues();
    const porHora = {};
    let totalPessoas = 0;

    for (let i = 1; i < dados.length; i++) {
      if (normalizarDataParaPtBr(dados[i][0]) !== dataPtBr) continue;
      if (String(dados[i][6]).trim() === "CANCELADA") continue;

      const horario = normalizarHorario(dados[i][1]);
      const pessoas = Number(dados[i][4]) || 0;
      const nome = dados[i][2] || "";
      const obs = String(dados[i][5] || "").trim();
      const codigo = String(dados[i][8] || dados[i][6] || "").trim();

      if (!porHora[horario]) porHora[horario] = { pessoas: 0, linhas: [] };
      porHora[horario].pessoas += pessoas;
      totalPessoas += pessoas;

      const obsCurta = (!obs || obs === "Nenhuma" || obs.indexOf("Reserva inserida manualmente") === 0)
        ? ""
        : obs;
      porHora[horario].linhas.push(
        "  " + codigo + "  " + nome + "  " + pessoas + "p" + (obsCurta ? "  " + obsCurta : "")
      );
    }

    const props = PropertiesService.getScriptProperties();
    const mapa = JSON.parse(props.getProperty("calEventosPorData") || "{}");
    const eventId = mapa[dataPtBr] || "";
    const cal = CalendarApp.getDefaultCalendar();

    // Dia só com canceladas (ou vazio): tira o evento da parede.
    if (totalPessoas <= 0) {
      if (eventId) {
        try { cal.getEventById(eventId).deleteEvent(); } catch (e1) {}
        delete mapa[dataPtBr];
        props.setProperty("calEventosPorData", JSON.stringify(mapa));
      }
      return;
    }

    const agenda = obterMapaAgendaLiberada()[dataPtBr] || ["12:00", "16:00"];
    const horas = agenda.slice().sort();
    const inicio = dataHoraSp(dataPtBr, horas[0] || "12:00");
    const fim = dataHoraSp(dataPtBr, somarUmaHora(horas[horas.length - 1] || "16:00"));

    const titulo = "Riso " + dataPtBr.slice(0, 5) + " · " + totalPessoas + "p";
    const partesDesc = ["Riso — " + dataPtBr, "Total: " + totalPessoas + " pessoas", ""];
    Object.keys(porHora).sort().forEach(function (h) {
      partesDesc.push(h + "  (" + porHora[h].pessoas + "/8)");
      porHora[h].linhas.forEach(function (l) { partesDesc.push(l); });
      partesDesc.push("");
    });
    const descricao = partesDesc.join("\n");

    if (eventId) {
      try {
        const ev = cal.getEventById(eventId);
        ev.setTitle(titulo);
        ev.setTime(inicio, fim);
        ev.setDescription(descricao);
        return;
      } catch (e2) {
        // Id sumiu (alguém apagou na agenda): cria de novo.
        delete mapa[dataPtBr];
      }
    }

    const criado = cal.createEvent(titulo, inicio, fim, { description: descricao });
    mapa[dataPtBr] = criado.getId();
    props.setProperty("calEventosPorData", JSON.stringify(mapa));
  } catch (err) {
    console.error("Calendario: " + err);
  }
}

function dataHoraSp(dataPtBr, hhmm) {
  const p = String(dataPtBr).split("/");
  const h = String(hhmm).split(":");
  return new Date(
    Number(p[2]), Number(p[1]) - 1, Number(p[0]),
    Number(h[0] || 12), Number(h[1] || 0), 0
  );
}

function somarUmaHora(hhmm) {
  const h = String(hhmm).split(":");
  return String(Number(h[0]) + 1).padStart(2, "0") + ":" + (h[1] || "00");
}